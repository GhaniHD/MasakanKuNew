APP_NAME=MasakanKu
APP_ENV=production
APP_KEY=                        # generate: php artisan key:generate
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://your-app.railway.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Log ke stderr agar terbaca di Railway/Render dashboard
LOG_CHANNEL=stderr
LOG_LEVEL=error

# ─── DATABASE (Railway inject otomatis, Render isi manual) ───────────────────
DB_CONNECTION=mysql
DB_HOST=${MYSQLHOST}
DB_PORT=${MYSQLPORT}
DB_DATABASE=${MYSQLDATABASE}
DB_USERNAME=${MYSQLUSER}
DB_PASSWORD=${MYSQLPASSWORD}

# ─── SESSION & CACHE ─────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true      # wajib true untuk HTTPS

BROADCAST_CONNECTION=log

# ─── FILESYSTEM ──────────────────────────────────────────────────────────────
# Ganti ke 'cloudinary' setelah setup Cloudinary account
FILESYSTEM_DISK=cloudinary

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── QUEUE & CACHE ───────────────────────────────────────────────────────────
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=masakanku_

# ─── MAIL ────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@masakanku.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
